rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function storeData(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data;
    }

    function isStoreMember(storeId) {
      return signedIn()
        && (storeData(storeId).ownerUid == request.auth.uid
          || request.auth.uid in storeData(storeId).bantayUids);
    }

    function isStoreOwner(storeId) {
      return signedIn() && storeData(storeId).ownerUid == request.auth.uid;
    }

    function validCatalogProduct(productId) {
      return request.resource.data.keys().hasOnly([
          'barcode', 'name', 'brand', 'quantity', 'imageUrl', 'source',
          'fetchedAt', 'openFoodFacts', 'createdBy', 'serverUpdatedAt'
        ])
        && request.resource.data.barcode == productId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && (request.resource.data.brand == null
          || (request.resource.data.brand is string && request.resource.data.brand.size() <= 80))
        && (request.resource.data.quantity == null
          || (request.resource.data.quantity is string && request.resource.data.quantity.size() <= 40))
        && (request.resource.data.imageUrl == null
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imageUrl.matches('https://.*')))
        && request.resource.data.source in ['manual', 'open_food_facts']
        && request.resource.data.fetchedAt is string
        && request.resource.data.openFoodFacts is map
        && (!('createdBy' in request.resource.data)
          || (request.resource.data.createdBy is string
            && request.resource.data.createdBy.size() > 0
            && request.resource.data.createdBy.size() <= 128))
        && (request.resource.data.source != 'manual'
          || request.resource.data.createdBy == request.auth.uid)
        && request.resource.data.serverUpdatedAt is timestamp;
    }

    function validStore() {
      return request.resource.data.keys().hasOnly([
          'name', 'ownerUid', 'bantayUids', 'lastPairingCode', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid.size() > 0
        && request.resource.data.bantayUids is list
        && request.resource.data.bantayUids.size() <= 25
        && !(request.resource.data.ownerUid in request.resource.data.bantayUids)
        && (!('lastPairingCode' in request.resource.data)
          || request.resource.data.lastPairingCode == null
          || (request.resource.data.lastPairingCode is string
            && request.resource.data.lastPairingCode.matches('[A-Za-z0-9]{20}')))
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function pairingData(pairingCode) {
      return get(/databases/$(database)/documents/bantay_pairing_codes/$(pairingCode)).data;
    }

    function validBantayMembershipChange(storeId) {
      let previous = resource.data.bantayUids.toSet();
      let next = request.resource.data.bantayUids.toSet();
      let added = next.difference(previous);
      let removed = previous.difference(next);
      return added.size() == 0
        || (removed.size() == 0
          && added.size() == 1
          && request.resource.data.lastPairingCode is string
          && pairingData(request.resource.data.lastPairingCode).claimedByStoreId == null
          && pairingData(request.resource.data.lastPairingCode).expiresAt > request.time
          && added == [pairingData(request.resource.data.lastPairingCode).bantayUid].toSet()
          && getAfter(/databases/$(database)/documents/bantay_pairing_codes/$(request.resource.data.lastPairingCode))
            .data.claimedByStoreId == storeId
          && getAfter(/databases/$(database)/documents/bantay_pairing_codes/$(request.resource.data.lastPairingCode))
            .data.claimedAt == request.time);
    }

    function validStoreProduct(productId) {
      return request.resource.data.keys().hasOnly([
          'catalogProductId', 'priceCentavos', 'priceUpdatedAt', 'updatedBy',
          'mutationId', 'serverUpdatedAt'
        ])
        && request.resource.data.catalogProductId == productId
        && request.resource.data.priceCentavos is int
        && request.resource.data.priceCentavos >= 0
        && request.resource.data.priceCentavos <= 100000000
        && request.resource.data.priceUpdatedAt is string
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.mutationId is string
        && request.resource.data.mutationId.size() > 0
        && request.resource.data.mutationId.size() <= 128
        && request.resource.data.serverUpdatedAt is timestamp
        && exists(/databases/$(database)/documents/catalog_products/$(productId));
    }

    function validPendingPriceRequest(productId) {
      return request.resource.data.keys().hasOnly([
          'barcode', 'name', 'brand', 'quantity', 'source', 'imageUrl', 'requestedBy',
          'requestedAt', 'status', 'answeredAt'
        ])
        && request.resource.data.barcode == productId
        && (request.resource.data.name == null
          || (request.resource.data.name is string && request.resource.data.name.size() <= 120))
        && (request.resource.data.brand == null
          || (request.resource.data.brand is string && request.resource.data.brand.size() <= 80))
        && (request.resource.data.quantity == null
          || (request.resource.data.quantity is string && request.resource.data.quantity.size() <= 40))
        && request.resource.data.source in ['manual', 'open_food_facts']
        && (request.resource.data.imageUrl == null
          || (request.resource.data.imageUrl is string
            && request.resource.data.imageUrl.size() <= 2048
            && request.resource.data.imageUrl.matches('https://.*')))
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedAt == request.time
        && request.resource.data.status == 'pending'
        && request.resource.data.answeredAt == null;
    }

    function validPairingCode() {
      return request.resource.data.keys().hasOnly([
          'bantayUid', 'createdAt', 'expiresAt', 'claimedByStoreId', 'claimedAt'
        ])
        && request.resource.data.bantayUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt <= request.time + duration.value(10, 'm')
        && request.resource.data.claimedByStoreId == null
        && request.resource.data.claimedAt == null;
    }

    match /catalog_products/{productId} {
      allow read: if signedIn();
      allow create: if signedIn() && validCatalogProduct(productId);
      allow update: if signedIn()
        && validCatalogProduct(productId)
        && request.resource.data.barcode == resource.data.barcode
        && ((resource.data.source == 'open_food_facts'
            && request.resource.data.source == 'open_food_facts')
          || (resource.data.source == 'manual'
            && request.resource.data.source == 'manual'
            && resource.data.createdBy == request.auth.uid
            && request.resource.data.createdBy == request.auth.uid));
      allow delete: if false;
    }

    match /stores/{storeId} {
      allow read: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.bantayUids);
      allow create: if signedIn()
        && storeId == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.bantayUids.size() == 0
        && validStore();
      allow update: if isStoreOwner(storeId)
        && validStore()
        && validBantayMembershipChange(storeId)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;

      match /products/{productId} {
        allow read: if isStoreMember(storeId);
        allow create, update: if isStoreOwner(storeId) && validStoreProduct(productId);
        allow delete: if isStoreOwner(storeId);
      }

      match /price_requests/{productId} {
        allow read: if isStoreMember(storeId);
        allow create: if isStoreMember(storeId)
          && !isStoreOwner(storeId)
          && validPendingPriceRequest(productId);
        allow update: if (
            isStoreMember(storeId)
            && !isStoreOwner(storeId)
            && resource.data.status == 'pending'
            && validPendingPriceRequest(productId)
          ) || (
            isStoreOwner(storeId)
            && resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'answeredAt'])
            && request.resource.data.status == 'answered'
            && request.resource.data.answeredAt == request.time
            && existsAfter(/databases/$(database)/documents/stores/$(storeId)/products/$(productId))
          );
        allow delete: if false;
      }
    }

    match /bantay_pairing_codes/{pairingCode} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && validPairingCode();
      allow update: if signedIn()
        && resource.data.claimedByStoreId == null
        && resource.data.claimedAt == null
        && resource.data.expiresAt > request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['claimedByStoreId', 'claimedAt'])
        && request.resource.data.claimedByStoreId is string
        && request.resource.data.claimedByStoreId.size() > 0
        && request.resource.data.claimedAt == request.time
        && isStoreOwner(request.resource.data.claimedByStoreId)
        && getAfter(/databases/$(database)/documents/stores/$(request.resource.data.claimedByStoreId))
          .data.bantayUids.hasAny([resource.data.bantayUid]);
      allow delete: if signedIn() && resource.data.bantayUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
