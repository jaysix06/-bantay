{
  "expo": {
    "name": "Bantay",
    "slug": "bantay",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "bantay",
    "userInterfaceStyle": "automatic",
    "android": {
      "package": "com.bantay.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#FFC06B"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bantay to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sqlite",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
